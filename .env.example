# ═══════════════════════════════════════════════════════════════════════════════
# FLOCKR — COMPLETE .env FILE
# Copy this to .env in your project root, then fill every value marked ← CHANGE
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core App ──────────────────────────────────────────────────────────────────
APP_NAME=Flockr
APP_ENV=production                          # local | staging | production
APP_KEY=                                    # ← RUN: php artisan key:generate
APP_DEBUG=false                             # NEVER true in production
APP_URL=http://localhost                    # ← Your actual domain
APP_TIMEZONE=Africa/Lagos

# ── Database (PostgreSQL 16) ──────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flockr
DB_USERNAME=flockr
DB_PASSWORD=                                # ← CHANGE to a strong password (32+ chars)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null                         # ← Set a password if Redis is exposed
REDIS_PORT=6379

# ── Cache / Session / Queue (all use Redis) ───────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb                 # reverb | pusher

# ── File Storage — Cloudflare R2 ─────────────────────────────────────────────
# Get these from: dash.cloudflare.com → R2 → Manage API Tokens
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=                          # ← R2 Access Key ID
AWS_SECRET_ACCESS_KEY=                      # ← R2 Secret Access Key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=flockr-media                     # ← Your R2 bucket name
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com   # ← Replace ACCOUNT_ID
AWS_USE_PATH_STYLE_ENDPOINT=true
R2_PUBLIC_URL=https://media.flockr.ng       # ← R2 custom domain (or public URL)

# ── AI Services ───────────────────────────────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-                     # ← Your OpenAI key

# Jina AI — https://jina.ai (free tier: 1M tokens/month)
JINA_API_KEY=jina_                          # ← Your Jina key

# ── Payments — Paystack ───────────────────────────────────────────────────────
# Get from: dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=pk_live_                # ← Live public key
PAYSTACK_SECRET_KEY=sk_live_               # ← Live secret key (NEVER expose this)
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# ── Realtime — Laravel Reverb (self-hosted, free) ─────────────────────────────
# Reverb runs on your server via supervisor. Use Pusher if you want managed.
REVERB_APP_ID=flockr-app
REVERB_APP_KEY=                             # ← Any random 32-char string
REVERB_APP_SECRET=                          # ← Any random 64-char string
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=https

# These are used by the frontend (Vite exposes VITE_ vars to JS)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${APP_URL}"              # Without https://
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"

# ── Email — Mailgun ───────────────────────────────────────────────────────────
# Sign up at mailgun.com — free tier: 100 emails/day
MAIL_MAILER=mailgun
MAILGUN_DOMAIN=mg.flockr.ng                # ← Your Mailgun domain
MAILGUN_SECRET=key-                         # ← Mailgun Private API Key
MAILGUN_ENDPOINT=api.mailgun.net
MAIL_FROM_ADDRESS=hello@flockr.ng
MAIL_FROM_NAME=Flockr

# ── Social Auth (optional for MVP, add later) ─────────────────────────────────
# Google: console.cloud.google.com → APIs → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://flockr.ng/auth/google/callback

# Facebook: developers.facebook.com → Your App → Settings
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://flockr.ng/auth/facebook/callback

# ── SMS OTP — Termii (Nigerian SMS gateway) ───────────────────────────────────
# Sign up at termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=Flockr

# ── Platform Business Config ──────────────────────────────────────────────────
FLOCKR_PLATFORM_FEE_PERCENT=5              # Flockr takes 5% of every sale
FLOCKR_MAX_VIDEO_SIZE_MB=500
FLOCKR_MAX_VIDEO_DURATION_SECONDS=180

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error                            # debug | info | warning | error
