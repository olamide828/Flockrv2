APP_NAME=Flockr
APP_ENV=production
APP_KEY=                            # php artisan key:generate
APP_DEBUG=false
APP_URL=https://flockr.ng
APP_TIMEZONE=Africa/Lagos

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flockr
DB_USERNAME=flockr
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Cache / Session / Queue ───────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ── File Storage (Cloudflare R2) ──────────────────────────────────────────────
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=flockr-media
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
R2_PUBLIC_URL=https://media.flockr.ng            # Your R2 custom domain

# ── AI Services ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
JINA_API_KEY=jina_...

# ── Payments (Paystack) ───────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# ── Realtime (choose one) ─────────────────────────────────────────────────────
# Option A: Laravel Reverb (self-hosted, free)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=flockr
REVERB_APP_KEY=your_reverb_key
REVERB_APP_SECRET=your_reverb_secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=https

# Option B: Pusher (managed, easier)
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1

# ── Mail (Termii for Nigerian SMS, Mailgun for email) ─────────────────────────
MAIL_MAILER=mailgun
MAILGUN_DOMAIN=mg.flockr.ng
MAILGUN_SECRET=key-...
MAIL_FROM_ADDRESS=hello@flockr.ng
MAIL_FROM_NAME=Flockr

# ── Platform config ───────────────────────────────────────────────────────────
FLOCKR_PLATFORM_FEE_PERCENT=5        # Flockr takes 5% of every sale
FLOCKR_MAX_VIDEO_SIZE_MB=500
FLOCKR_MAX_VIDEO_DURATION_SECONDS=180

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error
